// Camera Motion — keyframed camera.orbit / camera.zoom / camera.move_to
cube room at (0, 0) size=2.5;
axes3d grid at (0, 0) length=3;

play showCreation(room) 1.5s smooth;
play showCreation(grid) 1.0s smooth;

// Orbit into 3D perspective
play camera.orbit(phi=65, theta=-45) 2.0s smooth;

// Zoom in toward the cube
play camera.zoom(factor=1.6) 1.2s smooth;

// Pan across the scene
play camera.move_to(x=1.5, y=1.0) 1.5s smooth;

// Back to 2D top-down view
play camera.orbit(phi=0, theta=0) 1.5s smooth;
play camera.move_to(x=0, y=0) 1.0s smooth;

wait 0.5s;
