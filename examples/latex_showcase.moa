// Gaussian Integral & Euler's Formula MathOxide Showcase (.moa)
// LaTeX equations compiled into quadratic Bézier curves via Typst engine

// Title text (refined vector typography)
text title text="Gaussian Integral & Euler Identity" at (0, 3.2) size=0.7 color=#FFFFFF;

// First equation: Gaussian Integral
tex eq1 text="\int_{-\infty}^{\infty} e^{-x^2} dx = \sqrt{\pi}" at (0, 1.2) size=1.3 color=#58C4DD;

// Second equation: Euler's Formula
tex eq2 text="e^{i\pi} + 1 = 0" at (0, -1.2) size=1.5 color=#F9C74F;

// Target equation for transform: e^{i\theta} = \cos(\theta) + i \sin(\theta)
tex eq3 text="e^{i\theta} = \cos(\theta) + i \sin(\theta)" at (0, -1.2) size=1.3 color=#FC6255;

// Animation sequence
play write(title) 1.0s smooth;
play write(eq1) 1.8s smooth;
play indicate(eq1) 1.0s;
play spinInFromNothing(eq2) 1.2s;
wait 0.5s;
play wiggle(eq2) 1.0s;
wait 0.5s;
play transform(eq2, eq3) 1.5s smooth;
wait 1.0s;
