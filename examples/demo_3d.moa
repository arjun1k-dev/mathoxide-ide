// MathOxide 3D Primitives & Orbit Showcase
text title text="MathOxide 3D Perspective & Surfaces" at (0, 3.3) size=0.7 color=white;
axes3d ax at (0, -0.5) x=(-3.5, 3.5) y=(-3.5, 3.5) z=(-2.5, 2.5) sw=2;
cube box at (-2.5, 0) side=1.8 stroke=#FC6255 sw=2.5;
sphere ball at (2.5, 0) r=1.0 stroke=#F9C74F sw=2;
surface3d surf at (0, -0.5) expr="sin(x)*cos(y)*0.8" x=(-2.5, 2.5) y=(-2.5, 2.5) res=14 stroke=#58C4DD sw=1.5;

play write(title) 1.0s smooth;
play showCreation(ax) 1.2s smooth;
play showCreation(box) 1.5s smooth;
play showCreation(ball) 1.5s smooth;
play showCreation(surf) 2.0s smooth;
wait 1.0s;
